---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ViewsScript from '../components/ViewsScript.astro';
import ArticleContents from '../components/ArticleContents.astro';
import { SITE_CONFIG } from '../site.config';
import {
  getPublishedPosts,
  postSlug,
  formatDate,
  isoDate,
  isSameDay,
  type Post,
} from '../lib/posts';
import { postPath, canonicalPostUrl, absoluteUrl } from '../lib/url';
import { officeArticleSlugs, officeTopicName, officeTopicPath } from '../lib/ai-office';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post, i) => ({
    params: { slug: postSlug(post) },
    props: {
      post,
      prev: posts[i + 1] as Post | undefined, // 上一篇（更早发布）
      next: posts[i - 1] as Post | undefined, // 下一篇（更晚发布）
    },
  }));
}

const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);
const sectionDepth = Math.min(...headings.map((heading) => heading.depth));
const sections = headings.filter((heading) => heading.depth === sectionDepth && heading.slug);
const showContents = sections.length >= 3;

const slug = postSlug(post);
const url = canonicalPostUrl(slug);
const description = post.data.seoDescription || post.data.description || post.data.title;
const hasUpdate = post.data.updated && !isSameDay(post.data.date, post.data.updated);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': url + '#article',
  headline: post.data.title,
  description,
  inLanguage: 'zh-CN',
  datePublished: isoDate(post.data.date),
  dateModified: isoDate(post.data.updated ?? post.data.date),
  author: {
    '@type': 'Person',
    '@id': absoluteUrl('/#author'),
    name: SITE_CONFIG.author,
    url: absoluteUrl('/#author'),
  },
  publisher: { '@id': absoluteUrl('/#author') },
  isPartOf: { '@id': SITE_CONFIG.domain + '/#website' },
  image: [absoluteUrl(post.data.image ?? SITE_CONFIG.ogImageDefault)],
  url,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': url,
  },
};

const year = new Date().getFullYear();
---

<BaseLayout
  title={(post.data.seoTitle ?? post.data.title) + ' - ' + SITE_CONFIG.name}
  description={description}
  canonicalPath={postPath(slug)}
  ogType="article"
  image={post.data.image}
  imageAlt={post.data.imageAlt}
  noindex={post.data.noindex}
  jsonLd={jsonLd}
>
  <a class="skip-link" href="#article-start">跳到正文</a>
  <div class="layout">
    <aside class="sidebar">
      <div class="sidebar-inner">
        <a class="sidebar-title" href="/">{SITE_CONFIG.displayName}</a>
        <p class="sidebar-desc">{SITE_CONFIG.description}</p>

        <a class="archive-link" href="/">全部文章</a>
        {showContents && (
          <nav class="sidebar-nav" aria-label="本文目录">
            <h2>本文目录</h2>
            <ArticleContents headings={sections} />
          </nav>
        )}

        <div class="sidebar-footer">
          © {year} {SITE_CONFIG.displayName}<br />
          Powered by Astro &amp; Cloudflare
        </div>
      </div>
    </aside>

    <main class="article-main">
      <div class="article-topbar">
        {officeArticleSlugs.has(slug) ? (
          <nav class="office-crumb" aria-label="面包屑">
            <a href="/">首页</a>
            <span aria-hidden="true">/</span>
            <a href={officeTopicPath}>{officeTopicName}</a>
          </nav>
        ) : <a class="back-home" href="/">佬刘首页</a>}
        <a class="x-link" href={SITE_CONFIG.xUrl} target="_blank" rel="noopener noreferrer">
          X{SITE_CONFIG.xHandle ? ' / ' + SITE_CONFIG.xHandle : ''}
        </a>
      </div>

      <article>
        <h1 class="article-title" id="article-start" tabindex="-1">{post.data.title}</h1>
        <p class="article-meta">
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          {hasUpdate && <span>更新于 {formatDate(post.data.updated!)}</span>}
          <span data-nosnippet><ViewsScript slug={slug} increment={true} /></span>
        </p>

        {post.data.wechat_url && (
          <p class="article-wechat" data-nosnippet>
            首发于微信公众号「{SITE_CONFIG.wechatName}」 ·
            <a href={post.data.wechat_url} target="_blank" rel="noopener noreferrer">
              查看微信原文 ↗
            </a>
          </p>
        )}

        {showContents && (
          <details class="mobile-toc">
            <summary>本文目录</summary>
            <nav aria-label="本文目录"><ArticleContents headings={sections} /></nav>
          </details>
        )}
        <div class="prose">
          <Content />
        </div>

        <div class="post-end">
          <nav class="post-nav" aria-label="上一篇 / 下一篇">
            {prev && (
              <a href={postPath(postSlug(prev))}>
                <span class="nav-label">← 上一篇</span>{prev.data.title}
              </a>
            )}
            {next && (
              <a class="nav-next" href={postPath(postSlug(next))}>
                <span class="nav-label">下一篇 →</span>{next.data.title}
              </a>
            )}
          </nav>

          <div class="end-author" data-nosnippet>
            <p class="end-author-name">{SITE_CONFIG.displayName}</p>
            <p class="end-author-bio">
              {SITE_CONFIG.description}<br />
              {SITE_CONFIG.goal}
            </p>
            <a
              class="member-link"
              href={SITE_CONFIG.membership.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="member-title">{SITE_CONFIG.membership.title}</span>
              <span class="member-sub">{SITE_CONFIG.membership.subtitle}</span>
            </a>
            <p class="end-author-contact">
              公众号：{SITE_CONFIG.wechatName}<br />
              <a href={SITE_CONFIG.xUrl} target="_blank" rel="noopener noreferrer">
                X{SITE_CONFIG.xHandle ? ' / ' + SITE_CONFIG.xHandle : ''}
              </a>
            </p>
          </div>

        </div>
      </article>
    </main>
  </div>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { officeResources, officeRoutes, officeTopicName, officeTopicPath } from '../../lib/ai-office';
import { getPublishedPosts, postSlug } from '../../lib/posts';
import { absoluteUrl, postPath } from '../../lib/url';
import { SITE_CONFIG } from '../../site.config';

const title = `${officeTopicName}：可编辑 PPT、Excel 整理与两表核对 - ${SITE_CONFIG.name}`;
const description = '从文字资料或截图制作可编辑 PPT，用自制样例检查文件，也可以用 Excel 整理工作簿、核对订单与多条售后。附免费 PPT 检查器、示例文件、源 CSV 与核查报告。';
const publishedSlugs = new Set((await getPublishedPosts()).map(postSlug));
const canonical = absoluteUrl(officeTopicPath);
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': canonical,
    url: canonical,
    name: officeTopicName,
    description,
    inLanguage: 'zh-CN',
    isPartOf: { '@id': absoluteUrl('/#website') },
    breadcrumb: { '@id': canonical + '#breadcrumb' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    '@id': canonical + '#breadcrumb',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首页', item: absoluteUrl('/') },
      { '@type': 'ListItem', position: 2, name: officeTopicName, item: canonical },
    ],
  },
];
---

<BaseLayout title={title} description={description} canonicalPath={officeTopicPath} jsonLd={jsonLd}>
  <main class="topic">
    <header>
      <a href="/" class="home-link">佬刘首页</a>
      <h1>{officeTopicName}</h1>
    </header>

    <div class="tutorials">
      {officeRoutes.map((route) => (
        <section id={route.id} aria-labelledby={route.id + '-title'}>
          <h2 id={route.id + '-title'}>{route.name}</h2>
          <ul>
            {route.articles.filter((article) => publishedSlugs.has(article.slug)).map((article) => (
              <li><a href={postPath(article.slug)}>{article.label}</a></li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    <section class="resources" aria-labelledby="resources-title">
      <h2 id="resources-title">工具与样例</h2>
      <ul>
        {officeResources.map((resource) => <li><a href={resource.href}>{resource.label}</a></li>)}
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .topic {
    max-width: 1000px;
    margin: 0 auto;
    padding: 64px 32px;
  }
  h1, h2, ul { margin: 0; }
  ul { padding: 0; list-style: none; }
  a {
    color: var(--text-soft);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--muted);
    text-underline-offset: 4px;
  }
  a:hover, a:focus-visible { color: var(--text); text-decoration-color: currentColor; }
  .home-link { font-size: 14px; }
  h1 { margin-top: 18px; font-size: 32px; line-height: 1.3; }
  .tutorials {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 40px;
    margin-top: 36px;
  }
  section { scroll-margin-top: 20px; }
  h2 { font-size: 21px; line-height: 1.4; }
  .tutorials ul { margin-top: 10px; }
  li a { display: inline-block; padding-block: 6px; font-size: 16px; line-height: 1.6; }
  .resources { margin-top: 32px; padding-top: 20px; border-top: 1px solid var(--border); }
  .resources h2 { font-size: 15px; color: var(--text-soft); }
  .resources ul { display: flex; flex-wrap: wrap; column-gap: 24px; margin-top: 6px; }
  .resources a { font-size: 14px; }
  @media (max-width: 700px) {
    .topic { padding: 28px 20px 48px; }
    h1 { margin-top: 12px; font-size: 27px; }
    h2 { font-size: 20px; }
    .tutorials { grid-template-columns: minmax(0, 1fr); gap: 22px; margin-top: 24px; }
    .tutorials ul { margin-top: 6px; }
    .resources { margin-top: 24px; padding-top: 16px; }
    .resources ul { display: block; }
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import ViewsScript from '../components/ViewsScript.astro';
import { SITE_CONFIG } from '../site.config';
import { getPublishedPosts, postSlug, formatDate } from '../lib/posts';
import { postPath } from '../lib/url';
import { absoluteUrl } from '../lib/url';

const posts = await getPublishedPosts();
const year = new Date().getFullYear();

// 首页实体：站点与作者均使用可见的真实信息；sameAs 仅列已确认账号
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': absoluteUrl('/#website'),
    name: SITE_CONFIG.name,
    url: absoluteUrl('/'),
    description: SITE_CONFIG.seoDescription,
    inLanguage: 'zh-CN',
    publisher: { '@id': absoluteUrl('/#author') },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': absoluteUrl('/#author'),
    name: SITE_CONFIG.author,
    description: SITE_CONFIG.description,
    url: absoluteUrl('/'),
    sameAs: [SITE_CONFIG.xUrl],
  },
];
---

<BaseLayout
  title={SITE_CONFIG.seoTitle}
  description={SITE_CONFIG.seoDescription}
  canonicalPath="/"
  jsonLd={jsonLd}
>
  <div class="home-shell">
    <!-- 左栏：个人信息（桌面端 sticky，平板/手机变为顶部品牌行） -->
    <header class="home-brand">
      <div class="brand-main">
        <h1 class="site-title"><a href="/">{SITE_CONFIG.displayName}</a></h1>
        <p class="site-desc">{SITE_CONFIG.description}</p>
        <p class="site-goal">{SITE_CONFIG.goal}</p>

        <a
          class="member-link"
          href={SITE_CONFIG.membership.url}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="member-title">{SITE_CONFIG.membership.title}</span>
          <span class="member-sub">{SITE_CONFIG.membership.subtitle}</span>
        </a>

        <p class="site-wechat">公众号：{SITE_CONFIG.wechatName}</p>
        <a class="x-link" href={SITE_CONFIG.xUrl} target="_blank" rel="noopener noreferrer">
          X{SITE_CONFIG.xHandle ? ' / ' + SITE_CONFIG.xHandle : ''}
        </a>
      </div>
      <p class="brand-footer">
        © {year} {SITE_CONFIG.displayName}<br />
        laoliu.me
      </p>
    </header>

    <!-- 右栏：文章列表 -->
    <main class="post-list">
      {posts.map((post) => (
        <article class="post-item">
          <h2 class="post-title">
            <a href={postPath(postSlug(post))}>{post.data.title}</a>
          </h2>
          <p class="post-meta">
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
            <ViewsScript slug={postSlug(post)} />
          </p>
          {post.data.description && <p class="post-excerpt">{post.data.description}</p>}
        </article>
      ))}
    </main>
  </div>
</BaseLayout>
